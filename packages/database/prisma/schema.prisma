  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([tenantId,memberId])
}
model PortalMessage {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid
  memberId String @db.Uuid
  sender String
