model LegalDocument {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  matterId String @db.Uuid
  matter Matter @relation(fields:[tenantId,matterId],references:[tenantId,id],onUpdate:NoAction)
  title String
  kind String
  tags String[] @default([])
  status String @default("DRAFT")
  currentVersion Int @default(0)
  approvedVersion Int?
  approvedBy String? @db.Uuid
  approvedAt DateTime? @db.Timestamptz
  clientVisible Boolean @default(false)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  versions DocumentVersion[]
  @@unique([tenantId,id])
  @@index([tenantId,matterId])
}
model DocumentVersion {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  documentId String @db.Uuid
  document LegalDocument @relation(fields:[tenantId,documentId],references:[tenantId,id],onUpdate:NoAction)
