# Local development only. Replace ALL passwords before deployment.
DATABASE_URL=postgresql://legal_app:legal_dev_app@localhost:54329/legal
PLATFORM_DATABASE_URL=postgresql://legal_platform:legal_dev_platform@localhost:54329/legal
DIRECT_DATABASE_URL=postgresql://legal_owner:legal_dev_owner@localhost:54329/legal
REDIS_URL=redis://:legal_dev_redis@localhost:63799
WEB_ORIGIN=http://localhost:4310
INTERNAL_API_URL=http://127.0.0.1:4311
API_PORT=4311
SESSION_HOURS=12
NODE_ENV=development
# Optional until MFA is enabled. Generate 32 random bytes in base64; back it up securely.
MFA_ENCRYPTION_KEY=
# Password-recovery email stays disabled until a verified sender and key are configured.
RESEND_API_KEY=
EMAIL_FROM=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for production S3 SSE-S3. Local SeaweedFS uses its private development configuration.
S3_SERVER_SIDE_ENCRYPTION=
# Windows development invokes installed ClamAV/Tesseract/Poppler in this WSL distro.
DOCUMENT_TOOLS_WSL_DISTRO=Ubuntu
# BHD Identity SSO (register client bhd-legal at https://id.bhd-om.com/admin#clients).
BHD_IDENTITY_ISSUER=https://id.bhd-om.com
BHD_OAUTH_CLIENT_ID=bhd-legal
BHD_OAUTH_CLIENT_SECRET=
# Optional HS256 fallback for id_token verification when JWKS is RS256-only.
BHD_IDENTITY_TOKEN_SECRET=
AUTH_SECRET=
